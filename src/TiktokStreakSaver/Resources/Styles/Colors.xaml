<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Base Surface & Border Tokens (Obsidian Default, overridden dynamically by ThemeService) -->
    <Color x:Key="ObsidianBlack">#0A0D12</Color>
    <Color x:Key="ObsidianSurface">#13171F</Color>
    <Color x:Key="ObsidianSurfaceElevated">#161B24</Color>
    <Color x:Key="ObsidianBorder">#1F2430</Color>
    <Color x:Key="BorderSubtle">#10FFFFFF</Color>
    <Color x:Key="BorderGlow">#47FF3B5C</Color>

    <!-- Text Hierarchy Tokens -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#8E95A5</Color>
    <Color x:Key="BrandSubtitle">#6B7280</Color>

    <!-- Accent Tokens -->
    <Color x:Key="MintGreen">#10B981</Color>
    <Color x:Key="MintGreenNeon">#00E599</Color>
    <Color x:Key="CoralRed">#FF3B5C</Color>
    <Color x:Key="VioletPurple">#8B5CF6</Color>
    <Color x:Key="TealCyan">#06B6D4</Color>
    <Color x:Key="WarmAmber">#F59E0B</Color>
    <Color x:Key="DarkSlate">#161B24</Color>
    <Color x:Key="MutedIndigo">#13171F</Color>

    <!-- Semantic Brand Mappings -->
    <Color x:Key="Primary">#FF3B5C</Color>
    <Color x:Key="PrimaryDark">#FF3B5C</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="Secondary">#06B6D4</Color>
    <Color x:Key="SecondaryDarkText">#FFFFFF</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="Tertiary">#8B5CF6</Color>
    <Color x:Key="OnAccent">#FFFFFF</Color>
    <Color x:Key="OnSuccess">#FFFFFF</Color>
    <Color x:Key="OnWarning">#0F172A</Color>
    <Color x:Key="OnError">#FFFFFF</Color>

    <!-- Primary & Accent Tints -->
    <Color x:Key="PrimaryLight">#26FF3B5C</Color>
    <Color x:Key="PrimarySubtle">#1AFF3B5C</Color>
    <Color x:Key="AccentTint">#298B5CF6</Color>
    <Color x:Key="SecondaryTint">#2606B6D4</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#FF3B5C</Color>
    <Color x:Key="MidnightBlue">#0A0D12</Color>

    <!-- Page Canvas Backgrounds -->
    <Color x:Key="OffBlack">#0A0D12</Color>
    <Color x:Key="PageBackgroundLight">#0A0D12</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessDark">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningDark">#F59E0B</Color>
    <Color x:Key="Error">#FF3B5C</Color>
    <Color x:Key="ErrorDark">#FF3B5C</Color>
    <Color x:Key="Info">#06B6D4</Color>
    <Color x:Key="InfoDark">#06B6D4</Color>

    <!-- Neutral Surface Scale -->
    <Color x:Key="Gray100">#13171F</Color>
    <Color x:Key="Gray200">#161B24</Color>
    <Color x:Key="Gray300">#6B7280</Color>
    <Color x:Key="Gray400">#8E95A5</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#1F2430</Color>
    <Color x:Key="Gray700">#1F2430</Color>
    <Color x:Key="Gray800">#161B24</Color>
    <Color x:Key="Gray900">#13171F</Color>
    <Color x:Key="Gray950">#0A0D12</Color>

    <Color x:Key="OverlayLight">#E60A0D12</Color>
    <Color x:Key="OverlayDark">#E60A0D12</Color>

    <!-- Extended Dynamic Chrome & Banner Tokens -->
    <Color x:Key="NavBarBackground">#EB10141B</Color>
    <Color x:Key="ControlDockBackground">#EB13171F</Color>
    <Color x:Key="ThemeShadowColor">#70000000</Color>
    <Color x:Key="SwitchOffThumb">#8E95A5</Color>
    <Color x:Key="DisabledSurface">#1B202A</Color>
    <Color x:Key="DisabledText">#8C8E95A5</Color>
    <Color x:Key="WarningBannerBackground">#35250E</Color>
    <Color x:Key="WarningBannerBorder">#7F5819</Color>
    <Color x:Key="WarningBannerTitle">#FBBF24</Color>

    <!-- Card and Surface tokens -->
    <Color x:Key="CardBackgroundLight">#13171F</Color>
    <Color x:Key="CardBackgroundDark">#13171F</Color>
    <Color x:Key="SurfaceElevated">#161B24</Color>
    <Color x:Key="BorderColorLight">#1F2430</Color>
    <Color x:Key="BorderColorDark">#1F2430</Color>
    <Color x:Key="DeleteColor">#FF3B5C</Color>

    <Color x:Key="ListItemLight">#13171F</Color>
    <Color x:Key="ListItemDark">#13171F</Color>
    <Color x:Key="ListItemBorderLight">#1F2430</Color>
    <Color x:Key="ListItemBorderDark">#1F2430</Color>

    <!-- Explicit Brushes for DynamicResource bindings on Brush properties (Stroke, Shadow.Brush, Shape.Fill) -->
    <SolidColorBrush x:Key="ObsidianBlackBrush" Color="{StaticResource ObsidianBlack}"/>
    <SolidColorBrush x:Key="ObsidianSurfaceBrush" Color="{StaticResource ObsidianSurface}"/>
    <SolidColorBrush x:Key="ObsidianSurfaceElevatedBrush" Color="{StaticResource ObsidianSurfaceElevated}"/>
    <SolidColorBrush x:Key="ObsidianBorderBrush" Color="{StaticResource ObsidianBorder}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="CoralRedBrush" Color="{StaticResource CoralRed}"/>
    <SolidColorBrush x:Key="VioletPurpleBrush" Color="{StaticResource VioletPurple}"/>
    <SolidColorBrush x:Key="TealCyanBrush" Color="{StaticResource TealCyan}"/>
    <SolidColorBrush x:Key="MintGreenBrush" Color="{StaticResource MintGreen}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="ThemeShadowColorBrush" Color="{StaticResource ThemeShadowColor}"/>
    <SolidColorBrush x:Key="WarningBannerBorderBrush" Color="{StaticResource WarningBannerBorder}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <SolidColorBrush x:Key="BorderColorLightBrush" Color="{StaticResource BorderColorLight}"/>
    <SolidColorBrush x:Key="BorderColorDarkBrush" Color="{StaticResource BorderColorDark}"/>
</ResourceDictionary>
