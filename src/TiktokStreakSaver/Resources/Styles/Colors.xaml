<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Obsidian Stealth Palette Tokens (Design Specification) -->
    <Color x:Key="ObsidianBlack">#0A0D12</Color>
    <Color x:Key="ObsidianSurface">#13171F</Color>
    <Color x:Key="ObsidianSurfaceElevated">#161B24</Color>
    <Color x:Key="ObsidianBorder">#1F2430</Color>
    <Color x:Key="BorderSubtle">#10FFFFFF</Color>
    <Color x:Key="BorderGlow">#25FFFFFF</Color>

    <!-- Text Hierarchy Tokens -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#8E95A5</Color>
    <Color x:Key="BrandSubtitle">#6B7280</Color>

    <!-- Accent Tokens -->
    <Color x:Key="MintGreen">#10B981</Color>
    <Color x:Key="MintGreenNeon">#00E599</Color>
    <Color x:Key="CoralRed">#FF3B5C</Color>
    <Color x:Key="VioletPurple">#8B5CF6</Color>
    <Color x:Key="TealCyan">#06B6D4</Color>
    <Color x:Key="WarmAmber">#F59E0B</Color>
    <Color x:Key="DarkSlate">#1E1E24</Color>
    <Color x:Key="MutedIndigo">#181B26</Color>

    <!-- TikTok AutoStreak Brand Mappings -->
    <Color x:Key="Primary">#FF3B5C</Color>
    <Color x:Key="PrimaryDark">#FF3B5C</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#06B6D4</Color>
    <Color x:Key="SecondaryDarkText">#06B6D4</Color>
    <Color x:Key="Tertiary">#8B5CF6</Color>

    <!-- Primary Tints -->
    <Color x:Key="PrimaryLight">#26FF3B5C</Color>
    <Color x:Key="PrimarySubtle">#1AFF3B5C</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#FF3B5C</Color>
    <Color x:Key="MidnightBlue">#0A0D12</Color>

    <!-- Page Canvas Backgrounds -->
    <Color x:Key="OffBlack">#0A0D12</Color>
    <Color x:Key="PageBackgroundLight">#0A0D12</Color>

    <!-- Semantic Status Colors -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="SuccessDark">#00E599</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>
    <Color x:Key="Error">#FF3B5C</Color>
    <Color x:Key="ErrorDark">#EF4444</Color>
    <Color x:Key="Info">#06B6D4</Color>
    <Color x:Key="InfoDark">#38BDF8</Color>

    <!-- Neutral Surface Scale (Obsidian Dark Spectrum) -->
    <Color x:Key="Gray100">#13171F</Color>
    <Color x:Key="Gray200">#161B24</Color>
    <Color x:Key="Gray300">#4B5563</Color>
    <Color x:Key="Gray400">#8E95A5</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#374151</Color>
    <Color x:Key="Gray700">#1F2430</Color>
    <Color x:Key="Gray800">#161B24</Color>
    <Color x:Key="Gray900">#13171F</Color>
    <Color x:Key="Gray950">#0A0D12</Color>

    <Color x:Key="OverlayLight">#E60A0D12</Color>
    <Color x:Key="OverlayDark">#E60A0D12</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
    
    <!-- Card and Surface tokens -->
    <Color x:Key="CardBackgroundLight">#13171F</Color>
    <Color x:Key="CardBackgroundDark">#13171F</Color>
    <Color x:Key="SurfaceElevated">#161B24</Color>
    <Color x:Key="BorderColorLight">#1F2430</Color>
    <Color x:Key="BorderColorDark">#1F2430</Color>
    <Color x:Key="DeleteColor">#FF3B5C</Color>

    <Color x:Key="ListItemLight">#13171F</Color>
    <Color x:Key="ListItemDark">#13171F</Color>
    <Color x:Key="ListItemBorderLight">#1F2430</Color>
    <Color x:Key="ListItemBorderDark">#1F2430</Color>

    <!-- Explicit Brushes for AppThemeBindings on Strokes -->
    <SolidColorBrush x:Key="BorderColorLightBrush" Color="{StaticResource BorderColorLight}"/>
    <SolidColorBrush x:Key="BorderColorDarkBrush" Color="{StaticResource BorderColorDark}"/>
</ResourceDictionary>
