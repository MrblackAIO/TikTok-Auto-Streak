<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TiktokStreakSaver.Views"
             x:Class="TiktokStreakSaver.Pages.ProfilePage"
             Title="Profile"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource ObsidianBlack}">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- Header -->
                <VerticalStackLayout Spacing="2" Margin="0,8,0,0">
                    <Label Text="Preferences &amp; Schedule"
                           Style="{StaticResource PageTitleLabel}"
                           HorizontalOptions="Start"/>
                    <Label Text="TIKTOK AUTOSTREAK • CONFIGURATION"
                           FontFamily="InterSemiBold"
                           FontSize="11"
                           CharacterSpacing="1.2"
                           TextColor="{StaticResource BrandSubtitle}"
                           HorizontalOptions="Start"/>
                </VerticalStackLayout>

                <!-- ═══ 1. Session Settings / TikTok Profile Card ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label x:Name="SessionCardTitle"
                                   Text="Session Settings"
                                   Style="{StaticResource SectionLabel}"
                                   VerticalOptions="Center"/>
                            <Border Grid.Column="1"
                                    WidthRequest="10" HeightRequest="10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 5"
                                    BackgroundColor="{StaticResource MintGreen}"
                                    VerticalOptions="Center"
                                    x:Name="SessionDot"/>
                        </Grid>

                        <!-- A. Logged Out View -->
                        <VerticalStackLayout x:Name="LoggedOutPanel" Spacing="14" IsVisible="True">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14" VerticalOptions="Center">
                                <Border WidthRequest="50" HeightRequest="50"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource CoralRed}"
                                        StrokeShape="RoundRectangle 25"
                                        BackgroundColor="#20FF3B5C"
                                        VerticalOptions="Center">
                                    <Label Text="✕"
                                           TextColor="{StaticResource CoralRed}"
                                           FontFamily="InterBold"
                                           FontSize="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                    <Label Text="Not logged in"
                                           FontFamily="InterSemiBold"
                                           FontSize="15"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Connect TikTok to automate streaks"
                                           FontFamily="InterRegular"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Generic Display Name Entry -->
                            <Border Stroke="{StaticResource ObsidianBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}">
                                <Entry x:Name="DisplayNameEntry"
                                       Placeholder="Enter display name"
                                       Text="User"
                                       Margin="12,2"
                                       BackgroundColor="Transparent"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontFamily="InterSemiBold"
                                       FontSize="14"
                                       Completed="OnDisplayNameChanged"
                                       Unfocused="OnDisplayNameChanged"/>
                            </Border>

                            <Button x:Name="LoginButton"
                                    Text="Login to TikTok"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontFamily="InterSemiBold"
                                    FontSize="13"
                                    CornerRadius="14"
                                    HeightRequest="44"
                                    Clicked="OnLoginClicked"/>
                        </VerticalStackLayout>

                        <!-- B. Logged In Profile Account View -->
                        <VerticalStackLayout x:Name="LoggedInProfilePanel" Spacing="14" IsVisible="False">
                            <!-- Avatar & Identity -->
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <!-- 80x80 Avatar with bottom-right camera badge -->
                                <Grid WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                                    <Border WidthRequest="72" HeightRequest="72"
                                            StrokeThickness="2"
                                            Stroke="{StaticResource CoralRed}"
                                            StrokeShape="RoundRectangle 36"
                                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Grid>
                                            <Image x:Name="ProfilePhoto"
                                                   Aspect="AspectFill"
                                                   WidthRequest="72" HeightRequest="72"/>
                                            <Label x:Name="ProfileEmoji"
                                                   Text="🔥"
                                                   FontSize="32"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnProfilePhotoTapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>

                                    <!-- Camera Badge Overlay -->
                                    <Border WidthRequest="26" HeightRequest="26"
                                            StrokeThickness="1.5"
                                            Stroke="{StaticResource ObsidianBorder}"
                                            StrokeShape="RoundRectangle 13"
                                            BackgroundColor="#222834"
                                            HorizontalOptions="End"
                                            VerticalOptions="End">
                                        <Label Text="📷"
                                               FontSize="11"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnProfilePhotoTapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Spacing="3" HorizontalOptions="Center">
                                    <!-- Name with Pencil Icon -->
                                    <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="8" HorizontalOptions="Center">
                                        <Label x:Name="ProfileNicknameLabel"
                                               Text="User"
                                               FontFamily="InterBold"
                                               FontSize="18"
                                               TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center"
                                               HorizontalTextAlignment="Center"/>
                                        <Border Grid.Column="1"
                                                WidthRequest="26" HeightRequest="26"
                                                StrokeThickness="1"
                                                Stroke="{StaticResource ObsidianBorder}"
                                                StrokeShape="RoundRectangle 13"
                                                BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                                VerticalOptions="Center">
                                            <Label Text="✏️" FontSize="11" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEditNameClicked"/>
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </Grid>

                                    <!-- Single @username handle (Tap to edit/set) -->
                                    <Label x:Name="ProfileUsernameLabel"
                                           Text="@tiktok_user"
                                           FontFamily="InterMedium"
                                           FontSize="13"
                                           TextColor="{StaticResource TealCyan}"
                                           HorizontalTextAlignment="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEditUsernameClicked"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Bio Block (Editable) -->
                            <Border x:Name="BioContainer"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource ObsidianBorder}"
                                    StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    Padding="14,10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Bio"
                                               FontFamily="InterSemiBold"
                                               FontSize="11"
                                               TextColor="{StaticResource BrandSubtitle}"
                                               VerticalOptions="Center"/>
                                        <Label Grid.Column="1"
                                               Text="✏️ Edit"
                                               FontFamily="InterMedium"
                                               FontSize="11"
                                               TextColor="{StaticResource VioletPurple}"
                                               VerticalOptions="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEditBioClicked"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>
                                    <Label x:Name="BioLabel"
                                           Text="Add your bio"
                                           FontFamily="InterRegular"
                                           FontSize="13"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="WordWrap">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnEditBioClicked"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Session Status Indicator -->
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Text="●"
                                       TextColor="{StaticResource MintGreen}"
                                       FontSize="14"
                                       VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Session Active"
                                           FontFamily="InterSemiBold"
                                           FontSize="13"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label x:Name="SessionLastCheckLabel"
                                           Text="Verified and ready for automation"
                                           FontFamily="InterRegular"
                                           FontSize="11"
                                           TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Switch Account / Re-login Button -->
                            <Button x:Name="SwitchAccountButton"
                                    Text="Switch Account / Re-login"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontFamily="InterSemiBold"
                                    FontSize="13"
                                    CornerRadius="14"
                                    HeightRequest="42"
                                    Clicked="OnLoginClicked"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ 2. Automation Config Card ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Automation Config" Style="{StaticResource SectionLabel}"/>

                        <!-- 2x2 Feature Toggles Grid -->
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="10" ColumnSpacing="10">
                            
                            <!-- Auto-Retry (Fail-safe) -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    Stroke="{StaticResource ObsidianBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    Padding="12,10">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Auto-Retry"
                                           FontFamily="InterSemiBold" FontSize="13"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Fail-safe skip"
                                           FontFamily="InterRegular" FontSize="11"
                                           TextColor="{StaticResource CoralRed}"/>
                                    <Switch x:Name="SkipUnreachableSwitch"
                                            OnColor="{StaticResource CoralRed}"
                                            ThumbColor="{StaticResource White}"
                                            HorizontalOptions="Start"
                                            Toggled="OnSkipUnreachableToggled"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Custom Messages -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    Stroke="{StaticResource ObsidianBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    Padding="12,10">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Custom Messages"
                                           FontFamily="InterSemiBold" FontSize="13"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Randomizer mode"
                                           FontFamily="InterRegular" FontSize="11"
                                           TextColor="{StaticResource VioletPurple}"/>
                                    <Switch x:Name="RandomizeMessagesSwitch"
                                            OnColor="{StaticResource VioletPurple}"
                                            ThumbColor="{StaticResource White}"
                                            HorizontalOptions="Start"
                                            Toggled="OnRandomizeMessagesToggled"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Target Queue 1 (Friends) -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    Stroke="{StaticResource ObsidianBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    Padding="12,10">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Target Queue 1"
                                           FontFamily="InterSemiBold" FontSize="13"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Direct buddies"
                                           FontFamily="InterRegular" FontSize="11"
                                           TextColor="{StaticResource TealCyan}"/>
                                    <Switch IsToggled="True"
                                            OnColor="{StaticResource TealCyan}"
                                            ThumbColor="{StaticResource White}"
                                            HorizontalOptions="Start"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Target Queue 2 (Groups) -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    Stroke="{StaticResource ObsidianBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 16"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    Padding="12,10">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Target Queue 2"
                                           FontFamily="InterSemiBold" FontSize="13"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Group chats"
                                           FontFamily="InterRegular" FontSize="11"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Switch IsToggled="False"
                                            OnColor="{StaticResource TealCyan}"
                                            ThumbColor="{StaticResource Gray400}"
                                            HorizontalOptions="Start"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Priority Picker -->
                        <Grid ColumnDefinitions="*, 140" ColumnSpacing="12" Margin="0,4,0,0">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Chat Queue Priority" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="Order of target processing" Style="{StaticResource DataLabel}"/>
                            </VerticalStackLayout>
                            <Picker x:Name="ChatPriorityPicker"
                                    Grid.Column="1"
                                    Title="Priority"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontFamily="InterMedium"
                                    FontSize="13"
                                    VerticalOptions="Center"
                                    SelectedIndexChanged="OnChatPriorityChanged">
                                <Picker.Items>
                                    <x:String>Mixed</x:String>
                                    <x:String>Friends first</x:String>
                                    <x:String>Groups first</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>

                        <!-- Run Interval Panel -->
                        <VerticalStackLayout x:Name="IntervalPanel" Spacing="6" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                    <Label Text="Delay Timer / Interval" Style="{StaticResource ControlTitleLabel}"/>
                                    <Label x:Name="IntervalSummaryLabel"
                                           Text="Every 23 hours between automatic runs."
                                           Style="{StaticResource DataLabel}"/>
                                </VerticalStackLayout>
                                <Label x:Name="IntervalHoursValueLabel"
                                       Grid.Column="1"
                                       Text="23h"
                                       VerticalOptions="Center"
                                       FontFamily="InterBold"
                                       FontSize="16"
                                       TextColor="{StaticResource VioletPurple}"/>
                            </Grid>
                            <Stepper x:Name="IntervalHoursStepper"
                                     Minimum="1"
                                     Maximum="23"
                                     Increment="1"
                                     Value="23"
                                     VerticalOptions="Center"
                                     ValueChanged="OnIntervalHoursChanged"/>
                        </VerticalStackLayout>

                        <!-- iOS Shortcuts Compatibility Panel -->
                        <VerticalStackLayout x:Name="IosShortcutsSettingsPanel" IsVisible="False" Spacing="10">
                            <Button x:Name="IosLimitationsButton"
                                    Text="Why iOS is different"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    TextColor="{StaticResource TextPrimary}"
                                    CornerRadius="14" HeightRequest="40"
                                    Clicked="OnIosLimitationsClicked"/>
                            <Button x:Name="ShortcutTutorialButton"
                                    Text="Shortcut setup guide"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    TextColor="{StaticResource TextPrimary}"
                                    CornerRadius="14" HeightRequest="40"
                                    Clicked="OnShortcutTutorialClicked"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="SharedRunSettingsPanel" IsVisible="False"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ 3. Preferences & Schedule Card (Futuristic Radial Timer) ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout x:Name="AndroidSchedulingPanel" Spacing="16">
                        
                        <!-- Header -->
                        <Label Text="Schedule" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>

                        <!-- Futuristic Radial Arc Dial Timer -->
                        <GraphicsView x:Name="RadialTimerGraphicsView"
                                      HeightRequest="150"
                                      WidthRequest="150"
                                      HorizontalOptions="Center"/>

                        <!-- HH:MM Time Input Fields & AM/PM Pills -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                <!-- Hour Input -->
                                <Border WidthRequest="64" HeightRequest="52"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource ObsidianBorder}"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource ObsidianSurfaceElevated}">
                                    <Entry x:Name="ScheduleHourEntry"
                                           Text="12"
                                           Placeholder="12"
                                           Keyboard="Numeric"
                                           MaxLength="2"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           FontFamily="InterBold"
                                           FontSize="22"
                                           TextColor="{StaticResource TextPrimary}"
                                           BackgroundColor="Transparent"
                                           TextChanged="OnScheduleTimeInputChanged"/>
                                </Border>

                                <!-- Colon Separator -->
                                <Label Grid.Column="1"
                                       Text=":"
                                       FontFamily="InterBold"
                                       FontSize="26"
                                       TextColor="{StaticResource VioletPurple}"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"/>

                                <!-- Minute Input -->
                                <Border Grid.Column="2"
                                        WidthRequest="64" HeightRequest="52"
                                        StrokeThickness="1"
                                        Stroke="{StaticResource ObsidianBorder}"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource ObsidianSurfaceElevated}">
                                    <Entry x:Name="ScheduleMinuteEntry"
                                           Text="00"
                                           Placeholder="00"
                                           Keyboard="Numeric"
                                           MaxLength="2"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           FontFamily="InterBold"
                                           FontSize="22"
                                           TextColor="{StaticResource TextPrimary}"
                                           BackgroundColor="Transparent"
                                           TextChanged="OnScheduleTimeInputChanged"/>
                                </Border>

                                <!-- AM/PM Selection Capsules -->
                                <Grid Grid.Column="3" ColumnDefinitions="Auto, Auto" ColumnSpacing="6" VerticalOptions="Center" Margin="6,0,0,0">
                                    <Border x:Name="AmPill"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource ObsidianBorder}"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                            Padding="10,8">
                                        <Label x:Name="AmPillLabel"
                                               Text="AM"
                                               FontFamily="InterSemiBold" FontSize="12"
                                               TextColor="{StaticResource TextSecondary}"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAmTapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                    <Border Grid.Column="1"
                                            x:Name="PmPill"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource VioletPurple}"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="#268B5CF6"
                                            Padding="10,8">
                                        <Label x:Name="PmPillLabel"
                                               Text="PM"
                                               FontFamily="InterSemiBold" FontSize="12"
                                               TextColor="{StaticResource VioletPurple}"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPmTapped"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Label Text="Enter time in 12-hour format (e.g. 06:30)"
                                   FontFamily="InterRegular" FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Hidden TimePicker for platform synchronization -->
                        <TimePicker x:Name="ScheduleTimePicker"
                                    Format="h:mm tt"
                                    IsVisible="False"
                                    PropertyChanged="OnTimePickerChanged"/>

                        <!-- Background Run Toggle -->
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="16" Margin="0,4,0,0">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label x:Name="ScheduleTitleLabel" Text="Background Run" Style="{StaticResource ControlTitleLabel}"/>
                                <Label x:Name="ScheduleSubtitleLabel" Text="Automate streaks daily in background" Style="{StaticResource DataLabel}"/>
                            </VerticalStackLayout>
                            <Switch x:Name="ScheduleSwitch"
                                    Grid.Column="1"
                                    OnColor="{StaticResource CoralRed}"
                                    ThumbColor="{StaticResource White}"
                                    VerticalOptions="Center"
                                    Toggled="OnScheduleToggled"/>
                        </Grid>

                        <VerticalStackLayout x:Name="ScheduleOptionsPanel" IsVisible="False">
                            <Switch x:Name="FixedTimeSwitch" IsToggled="True" Toggled="OnFixedTimeToggled" IsVisible="False"/>
                            <Grid x:Name="TimePickerRow" IsVisible="False"/>
                        </VerticalStackLayout>

                        <!-- Low Battery Saver Toggle -->
                        <Grid x:Name="BatteryLowRow" ColumnDefinitions="*, Auto" ColumnSpacing="16">
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="Low Battery Saver" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="Send before battery depletion triggers" Style="{StaticResource DataLabel}"/>
                            </VerticalStackLayout>
                            <Switch x:Name="SendOnBatteryLowSwitch"
                                    Grid.Column="1"
                                    OnColor="{StaticResource TealCyan}"
                                    ThumbColor="{StaticResource Gray400}"
                                    VerticalOptions="Center"
                                    Toggled="OnSendOnBatteryLowToggled"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ 4. About & System Card ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="About" Style="{StaticResource SectionLabel}"/>
                        <VerticalStackLayout Spacing="3" Margin="0,2,0,4" HorizontalOptions="Center">
                            <Label Text="BY MRBLACK"
                                   FontFamily="InterBold" FontSize="14"
                                   CharacterSpacing="2"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center"/>
                            <Label x:Name="VersionLabel"
                                   FontFamily="InterRegular" FontSize="12"
                                   TextColor="{StaticResource BrandSubtitle}"
                                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button x:Name="CheckUpdatesButton"
                                    Text="Check for Updates"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontFamily="InterSemiBold"
                                    FontSize="12"
                                    CornerRadius="14"
                                    HeightRequest="42"
                                    Clicked="OnCheckUpdatesClicked"/>
                            <Button x:Name="PrivacyPolicyButton"
                                    Grid.Column="1"
                                    Text="Privacy Hub"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontFamily="InterSemiBold"
                                    FontSize="12"
                                    CornerRadius="14"
                                    HeightRequest="42"
                                    Clicked="OnPrivacyPolicyClicked"/>
                        </Grid>

                        <Button Text="Automation Guide &amp; Tips"
                                BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                TextColor="{StaticResource VioletPurple}"
                                FontFamily="InterSemiBold"
                                FontSize="12"
                                CornerRadius="14"
                                HeightRequest="42"
                                Clicked="OnAboutClicked"/>

                        <Label x:Name="AltStoreUpdatesLabel" Text="" IsVisible="False"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ 5. Data & Session Reset ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Account Data" Style="{StaticResource SectionLabel}"/>
                        <Button Text="Logout / Clear Session"
                                BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                TextColor="{StaticResource CoralRed}"
                                FontFamily="InterSemiBold"
                                FontSize="13"
                                CornerRadius="14"
                                HeightRequest="44"
                                Clicked="OnLogoutClicked"/>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="100" BackgroundColor="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Stealth background WebView for passive TikTok profile sync on existing sessions -->
        <WebView x:Name="ProfileSyncWebView"
                 Opacity="0"
                 WidthRequest="1"
                 HeightRequest="1"
                 InputTransparent="True"
                 HorizontalOptions="Start"
                 VerticalOptions="Start"
                 Navigated="OnProfileSyncWebViewNavigated"/>

        <views:FloatingNavBar CurrentTab="Profile" VerticalOptions="End"/>
    </Grid>
</ContentPage>
