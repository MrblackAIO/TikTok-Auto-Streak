<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TiktokStreakSaver.Pages.PrivacyPage"
             Title="Privacy &amp; Transparency Hub"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource ObsidianBlack}">

    <Grid RowDefinitions="*, Auto">

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,16,20,24" Spacing="16">

                <!-- ═══ 1. Header & Shield Emblem ═══ -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center" Margin="0,8,0,4">
                    <Border WidthRequest="68" HeightRequest="68"
                            StrokeThickness="1.5"
                            Stroke="{StaticResource TealCyan}"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                            HorizontalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#8006B6D4" Offset="0,0" Radius="18" Opacity="0.5"/>
                        </Border.Shadow>
                        <Label Text="🛡️"
                               FontSize="32"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Privacy &amp; Transparency Hub"
                           Style="{StaticResource PageTitleLabel}"
                           FontSize="22"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <Label Text="ENGINEERED BY MRBLACK"
                           FontFamily="InterBold"
                           FontSize="12"
                           CharacterSpacing="2"
                           TextColor="{StaticResource TealCyan}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <!-- Trust Capsule -->
                    <Border StrokeThickness="1"
                            Stroke="{StaticResource ObsidianBorder}"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                            Padding="12,5"
                            HorizontalOptions="Center"
                            Margin="0,2,0,0">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="6" VerticalOptions="Center">
                            <Label Text="●" TextColor="{StaticResource MintGreen}" FontSize="11" VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="100% Client-Side • Zero Telemetry • Open Source"
                                   FontFamily="InterSemiBold"
                                   FontSize="11"
                                   TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Label x:Name="EffectiveDateLabel"
                           Text="Effective date: November 11, 2026 • v2.0.9"
                           FontFamily="InterRegular"
                           FontSize="11"
                           TextColor="{StaticResource BrandSubtitle}"
                           HorizontalOptions="Center"
                           Margin="0,2,0,0"/>
                </VerticalStackLayout>

                <!-- ═══ 2. Official Project & Community Links ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Official Resources &amp; Links" Style="{StaticResource SectionLabel}"/>
                            <Label Text="Direct links to Mrblack's verified GitHub repository and community tools"
                                   Style="{StaticResource DataLabel}"/>
                        </VerticalStackLayout>

                        <!-- GitHub Repository -->
                        <Border StrokeThickness="1"
                                Stroke="{StaticResource ObsidianBorder}"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Label Text="🌐" FontSize="20" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="GitHub Repository" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Inspect the full open source code" FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="Visit ↗"
                                        FontFamily="InterSemiBold"
                                        FontSize="11"
                                        BackgroundColor="#2606B6D4"
                                        TextColor="{StaticResource TealCyan}"
                                        CornerRadius="10"
                                        HeightRequest="34"
                                        Padding="12,0"
                                        Clicked="OnViewOnGitHubClicked"/>
                            </Grid>
                        </Border>

                        <!-- Issues & Bug Reports -->
                        <Border StrokeThickness="1"
                                Stroke="{StaticResource ObsidianBorder}"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Label Text="🐛" FontSize="20" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Issues &amp; Bug Reports" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Submit bugs or feature requests to Mrblack" FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="Issues ↗"
                                        FontFamily="InterSemiBold"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource ObsidianSurface}"
                                        TextColor="{StaticResource TextPrimary}"
                                        CornerRadius="10"
                                        HeightRequest="34"
                                        Padding="12,0"
                                        Clicked="OnIssuesClicked"/>
                            </Grid>
                        </Border>

                        <!-- Releases & Signed APKs -->
                        <Border StrokeThickness="1"
                                Stroke="{StaticResource ObsidianBorder}"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Label Text="📦" FontSize="20" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Releases &amp; Downloads" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Download signed APKs and read changelogs" FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="Releases ↗"
                                        FontFamily="InterSemiBold"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource ObsidianSurface}"
                                        TextColor="{StaticResource TextPrimary}"
                                        CornerRadius="10"
                                        HeightRequest="34"
                                        Padding="12,0"
                                        Clicked="OnReleasesClicked"/>
                            </Grid>
                        </Border>

                        <!-- Raw PRIVACY.md -->
                        <Border StrokeThickness="1"
                                Stroke="{StaticResource ObsidianBorder}"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Label Text="📄" FontSize="20" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Raw Privacy Document" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="View PRIVACY.md on GitHub" FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="Policy ↗"
                                        FontFamily="InterSemiBold"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource ObsidianSurface}"
                                        TextColor="{StaticResource TextPrimary}"
                                        CornerRadius="10"
                                        HeightRequest="34"
                                        Padding="12,0"
                                        Clicked="OnPolicyDocClicked"/>
                            </Grid>
                        </Border>

                        <!-- MIT License -->
                        <Border StrokeThickness="1"
                                Stroke="{StaticResource ObsidianBorder}"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Label Text="⚖️" FontSize="20" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="Open Source License" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="Licensed under the MIT License" FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="2"
                                        Text="License ↗"
                                        FontFamily="InterSemiBold"
                                        FontSize="11"
                                        BackgroundColor="{StaticResource ObsidianSurface}"
                                        TextColor="{StaticResource TextPrimary}"
                                        CornerRadius="10"
                                        HeightRequest="34"
                                        Padding="12,0"
                                        Clicked="OnLicenseClicked"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ 3. Core Privacy Guarantees (TL;DR) ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Zero-Telemetry Architectural Guarantee" Style="{StaticResource SectionLabel}"/>
                        <Label Text="TikTok AutoStreak does not collect, transmit, sell, or monitor any personal data about you. There are no analytics, no third-party tracking SDKs, no advertising frameworks, and no developer-operated servers receiving anything about you or your automation usage."
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                        <Label Text="All operations execute 100% locally on your device's private sandbox storage."
                               FontFamily="InterSemiBold"
                               FontSize="13"
                               TextColor="{StaticResource MintGreen}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ 4. What Stays on Your Device ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Local Storage &amp; Data Control" Style="{StaticResource SectionLabel}"/>
                        <Label Text="The following information is saved locally on your device inside protected app storage and your system WebView cookie jar. It never leaves your phone:"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="• TikTok session cookies and User-Agent captured during your secure web login." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="• Friend and group configurations (usernames, display names, and streak counts)." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="• Custom message templates and randomizer preferences." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="• Scheduling preferences (12-hour AM/PM target time and battery saver flags)." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="• Execution history (last 50 runs capped for auditing)." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            <Label Text="• Locally selected profile photo and custom nickname." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>

                        <!-- Purge Button -->
                        <Button Text="Purge Session &amp; Local Data"
                                BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                TextColor="{StaticResource CoralRed}"
                                FontFamily="InterSemiBold"
                                FontSize="12"
                                CornerRadius="12"
                                HeightRequest="42"
                                Margin="0,4,0,0"
                                Clicked="OnClearDataClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ 5. Network Connections Audit ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Network Transparency Audit" Style="{StaticResource SectionLabel}"/>
                        <Label Text="The app only opens direct connections to two external destinations. There are zero intermediary or proxy servers:"
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>

                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="1. TikTok (tiktok.com &amp; subdomains)" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="When logging in and during scheduled background runs, the app interacts with TikTok via your device's native WebView using your personal session cookies to send your configured streak messages."
                                       Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="2. GitHub (api.github.com/repos/MrblackAIO/TikTok-Auto-Streak)" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="Only accessed for version checks and downloading signed release APK updates. Only standard User-Agent headers are sent; zero credentials, device IDs, or telemetry tokens are ever transmitted."
                                       Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ 6. System Permissions Breakdown ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Permissions &amp; Justifications" Style="{StaticResource SectionLabel}"/>
                        
                        <VerticalStackLayout Spacing="10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="INTERNET &amp; ACCESS_NETWORK_STATE" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="Direct communication with TikTok to deliver streak messages and GitHub to check for updates." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="FOREGROUND_SERVICE &amp; WAKE_LOCK" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="Ensures streak automation runs reliably without being killed mid-message by Android." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="SCHEDULE_EXACT_ALARM &amp; USE_EXACT_ALARM" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="Fires the streak sender precisely at your chosen 12-hour AM/PM time." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="RECEIVE_BOOT_COMPLETED" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="Automatically re-arms your scheduled streak alarm when your device restarts." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="2">
                                <Label Text="POST_NOTIFICATIONS" Style="{StaticResource ControlTitleLabel}"/>
                                <Label Text="Displays heads-up status alerts with custom audio when streaks finish sending." Style="{StaticResource ValueLabel}" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ 7. Developer & Attribution Statement ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Maintainer &amp; Open Source Notice" Style="{StaticResource SectionLabel}"/>
                        <Label Text="TikTok AutoStreak is actively developed, maintained, and engineered by Mrblack (MrblackAIO). This independent software is not affiliated with, endorsed by, or sponsored by ByteDance Ltd. or TikTok."
                               Style="{StaticResource ValueLabel}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="40" BackgroundColor="Transparent"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ Sticky Bottom Action Bar ═══ -->
        <Border Grid.Row="1" Style="{StaticResource BottomActionBorder}">
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <Button Text="Back"
                        Style="{StaticResource TextButton}"
                        HeightRequest="46"
                        Clicked="OnBackClicked"/>
                <Button Grid.Column="1"
                        Text="GitHub Repository ↗"
                        BackgroundColor="{StaticResource CoralRed}"
                        TextColor="{StaticResource White}"
                        FontFamily="InterSemiBold"
                        CornerRadius="14"
                        HeightRequest="46"
                        Clicked="OnViewOnGitHubClicked"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>