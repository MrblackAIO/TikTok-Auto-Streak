<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:TiktokStreakSaver.Views"
             x:Class="TiktokStreakSaver.Pages.DashboardPage"
             Title="Dashboard"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource ObsidianBlack}">

    <Grid>

        <RefreshView x:Name="MainRefreshView" Refreshing="OnRefreshing">
            <ScrollView x:Name="DashboardScrollView">
                <VerticalStackLayout Padding="20" Spacing="16">

                    <!-- ─── Header ─── -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,8,0,4">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label x:Name="GreetingLabel"
                                   Text="Hello, Mrblack"
                                   Style="{StaticResource PageTitleLabel}"
                                   HorizontalOptions="Start"/>
                            <Label Text="TIKTOK AUTOSTREAK"
                                   FontFamily="InterSemiBold"
                                   FontSize="11"
                                   CharacterSpacing="1.5"
                                   TextColor="{StaticResource BrandSubtitle}"
                                   HorizontalOptions="Start"/>
                        </VerticalStackLayout>

                        <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Center">
                            <Border x:Name="ProfileAvatarBorder"
                                    WidthRequest="44" HeightRequest="44"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource ObsidianBorder}"
                                    StrokeShape="RoundRectangle 22"
                                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                    HorizontalOptions="Center" VerticalOptions="Center">
                                <Image x:Name="ProfileAvatarImage"
                                       IsVisible="False"
                                       Aspect="AspectFill"
                                       WidthRequest="44" HeightRequest="44"/>
                            </Border>
                            <Label x:Name="ProfileAvatarEmoji"
                                   Text="⚡" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Grid>
                    </Grid>

                    <!-- ═══ Run Overview ═══ -->
                    <VerticalStackLayout Spacing="16">

                        <!-- Daily Automation Progress Gauge -->
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="14">
                                <Label x:Name="OverviewProgressLabel" Text="0/--" IsVisible="False"/>

                                <!-- Radial Neon Progress Arc Gauge -->
                                <GraphicsView x:Name="OverviewProgressGraphicsView"
                                              HeightRequest="160"
                                              HorizontalOptions="Fill" />

                                <!-- Compact Metric Cards (3 Columns) -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    
                                    <!-- Sent Today Metric Card -->
                                    <Border Grid.Column="0"
                                            Stroke="{StaticResource ObsidianBorder}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                            Padding="12,10">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Sent Today"
                                                   FontFamily="InterRegular" FontSize="11"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label x:Name="OverviewSentLabel" Text="0"
                                                   FontFamily="InterBold" FontSize="18"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label Text="active"
                                                   FontFamily="InterMedium" FontSize="10"
                                                   TextColor="{StaticResource MintGreen}"
                                                   HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Upcoming Metric Card -->
                                    <Border Grid.Column="1"
                                            Stroke="{StaticResource ObsidianBorder}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                            Padding="12,10">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Upcoming"
                                                   FontFamily="InterRegular" FontSize="11"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label x:Name="OverviewRemainingLabel" Text="--"
                                                   FontFamily="InterBold" FontSize="18"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label Text="days"
                                                   FontFamily="InterMedium" FontSize="10"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Success Rate Metric Card -->
                                    <Border Grid.Column="2"
                                            Stroke="{StaticResource ObsidianBorder}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                            Padding="12,10">
                                        <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                            <Label Text="Success Rate"
                                                   FontFamily="InterRegular" FontSize="11"
                                                   TextColor="{StaticResource TextSecondary}"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label x:Name="OverviewSuccessLabel" Text="--"
                                                   FontFamily="InterBold" FontSize="18"
                                                   TextColor="{StaticResource MintGreen}"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label Text="safe"
                                                   FontFamily="InterMedium" FontSize="10"
                                                   TextColor="{StaticResource MintGreen}"
                                                   HorizontalTextAlignment="Center"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <!-- Scheduled Timers Row -->
                                <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label x:Name="NextRunTitleLabel" Text="Next Scheduled Run" Style="{StaticResource DataLabel}"/>
                                        <Label x:Name="NextRunLabel" Text="Not scheduled"
                                               FontFamily="InterSemiBold" FontSize="14"
                                               TextColor="{StaticResource CoralRed}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" HorizontalOptions="End">
                                        <Label Text="Last Run" Style="{StaticResource DataLabel}" HorizontalTextAlignment="End"/>
                                        <Label x:Name="LastRunLabel" Text="Never"
                                               FontFamily="InterMedium" FontSize="14"
                                               TextColor="{StaticResource TextPrimary}"
                                               HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Run Configuration / Automation Text Card -->
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Automation Text" Style="{StaticResource SectionLabel}"/>
                                    <Border Grid.Column="1"
                                            StrokeThickness="1"
                                            Stroke="{StaticResource ObsidianBorder}"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                                            Padding="8,3">
                                        <Label Text="Editor"
                                               FontFamily="InterSemiBold" FontSize="11"
                                               TextColor="{StaticResource VioletPurple}"/>
                                    </Border>
                                </Grid>

                                <Label x:Name="RandomizeModeHint"
                                       Text="Randomized messages enabled — 50 built-in variants"
                                       Style="{StaticResource DataLabel}"
                                       LineBreakMode="WordWrap"
                                       IsVisible="False"/>

                                <VerticalStackLayout x:Name="CustomMessagePanel" Spacing="4">
                                    <Label x:Name="MessageEditorHint"
                                           Text="Message sent to each friend during a streak run"
                                           Style="{StaticResource DataLabel}"
                                           LineBreakMode="WordWrap"/>
                                    <Border x:Name="MessageEditorBorder"
                                            Stroke="{StaticResource ObsidianBorder}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}">
                                        <Editor x:Name="MessageEditor"
                                                Placeholder="Let's keep the streak ablaze! 🔥"
                                                HeightRequest="72"
                                                Margin="12,8"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource TextPrimary}"
                                                FontFamily="InterRegular"
                                                FontSize="14"
                                                TextChanged="OnMessageChanged"
                                                Unfocused="OnMessageUnfocused"
                                                Completed="OnMessageCompleted"/>
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Live Activity Panel -->
                        <Border x:Name="LiveLogPanel"
                                Style="{StaticResource SectionCard}"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Live Activity" Style="{StaticResource SectionLabel}"/>
                                <ScrollView x:Name="LiveLogScrollView"
                                            HeightRequest="160">
                                    <Label x:Name="LiveLogLabel"
                                           FontFamily="monospace"
                                           FontSize="11"
                                           LineBreakMode="WordWrap"
                                           TextColor="{StaticResource TextSecondary}"/>
                                </ScrollView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Label x:Name="PullToRefreshHintLabel"
                           Text="Pull down to check for updates"
                           FontFamily="InterRegular"
                           FontSize="12"
                           TextColor="{StaticResource TextSecondary}"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>

                    <BoxView HeightRequest="200" BackgroundColor="Transparent"/>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ═══ Control Dock Overlay ═══ -->
        <Border x:Name="ControlDockBorder"
                VerticalOptions="End"
                StrokeThickness="1"
                Stroke="{StaticResource ObsidianBorder}"
                StrokeShape="RoundRectangle 24"
                Padding="20,16"
                Margin="20,0,20,96"
                BackgroundColor="#EB13171F">
            <Border.Shadow>
                <Shadow Brush="#90000000" Offset="0,4" Radius="20" Opacity="1"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">
                <VerticalStackLayout x:Name="PermissionsPanel" IsVisible="False" Spacing="8">
                    <Label Text="To automate streaks reliably in the background, your device requires the following:"
                           Style="{StaticResource DataLabel}"
                           LineBreakMode="WordWrap"/>
                    <Button x:Name="BtnExactAlarm"
                            Text="Allow Exact Scheduling"
                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                            TextColor="{StaticResource TextPrimary}"
                            CornerRadius="12" HeightRequest="44"
                            Clicked="OnRequestExactAlarmClicked"/>
                    <Button x:Name="BtnBatteryOpt"
                            Text="Disable Battery Restrictions"
                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                            TextColor="{StaticResource TextPrimary}"
                            CornerRadius="12" HeightRequest="44"
                            Clicked="OnRequestBatteryOptimizationClicked"/>
                    <Button x:Name="BtnNotification"
                            Text="Allow Status Notifications"
                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                            TextColor="{StaticResource TextPrimary}"
                            CornerRadius="12" HeightRequest="44"
                            Clicked="OnRequestNotificationClicked"/>
                </VerticalStackLayout>

                <Grid x:Name="RunButtonsContainer"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="8">
                    <Button x:Name="MasterRunButton"
                            Text="RUN AUTOMATION NOW"
                            BackgroundColor="{StaticResource CoralRed}"
                            TextColor="{StaticResource White}"
                            FontFamily="InterBold"
                            FontSize="15"
                            CornerRadius="18"
                            HeightRequest="52"
                            Clicked="OnMasterRunClicked"/>
                    <Button x:Name="RetryFailedButton"
                            Grid.Row="1"
                            Text="Retry Failed"
                            IsVisible="False"
                            BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                            TextColor="{StaticResource TextPrimary}"
                            FontFamily="InterSemiBold"
                            CornerRadius="14"
                            HeightRequest="46"
                            Clicked="OnRetryFailedClicked"/>
                </Grid>

                <Button x:Name="StopServiceButton"
                        Text="Stop Processing"
                        IsVisible="False"
                        BackgroundColor="{StaticResource CoralRed}"
                        TextColor="White"
                        FontFamily="InterSemiBold"
                        CornerRadius="18"
                        HeightRequest="52"
                        Clicked="OnStopServiceClicked"/>
            </VerticalStackLayout>
        </Border>

        <!-- ═══ Floating Nav Bar ═══ -->
        <views:FloatingNavBar CurrentTab="Dashboard" VerticalOptions="End"/>
    </Grid>
</ContentPage>
