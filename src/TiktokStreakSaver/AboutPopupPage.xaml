<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TiktokStreakSaver.AboutPopupPage"
             BackgroundColor="{StaticResource ObsidianBlack}"
             Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20,16,20,12" RowSpacing="14">
        
        <!-- Header & Flame Glyph Logo -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="Center" Margin="0, 4, 0, 0">
            <!-- Minimalist Flame Glyph Logo (Screen 6) -->
            <Border WidthRequest="68" HeightRequest="68"
                    StrokeThickness="1"
                    Stroke="{StaticResource ObsidianBorder}"
                    StrokeShape="RoundRectangle 22"
                    BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                    HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#80FF3B5C" Offset="0,0" Radius="16" Opacity="0.4"/>
                </Border.Shadow>
                <Image Source="autostreaklogo.svg"
                       WidthRequest="46"
                       HeightRequest="46"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Border>

            <Label x:Name="HeaderTitle"
                   Text="TikTok AutoStreak"
                   Style="{StaticResource PageTitleLabel}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Label Text="BY MRBLACK"
                   FontFamily="InterBold"
                   FontSize="13"
                   CharacterSpacing="2.2"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Label x:Name="VersionLabel" 
                   FontFamily="InterSemiBold"
                   FontSize="12"
                   TextColor="{StaticResource BrandSubtitle}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
            <Label x:Name="SubHeaderLabel" 
                   Text="Stealth Obsidian Streak Automation" 
                   FontFamily="InterRegular"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>
        </VerticalStackLayout>

        <!-- Scrollable content area -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="14">

                <!-- ═══ Automation & Safety Guide ═══ -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Automation &amp; Safety Guide" Style="{StaticResource SectionLabel}"/>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Margin="0,2">
                            <Label Text="🕒" FontSize="16" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Daily Schedule" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Runs quietly in the background at your chosen target hour." FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Margin="0,2">
                            <Label Text="🔋" FontSize="16" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Smart Battery Guard" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Automatically sends streaks early before low-battery triggers." FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Margin="0,2">
                            <Label Text="⚡" FontSize="16" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Auto-Retry Engine" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Retries automatically if Wi-Fi or mobile data is temporarily disconnected." FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" Margin="0,2">
                            <Label Text="🛡️" FontSize="16" VerticalOptions="Start"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Streak Anti-Drop Protection" FontFamily="InterSemiBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="Uses safe human-like intervals and customizable messages." FontFamily="InterRegular" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                
                <!-- Changelog WebView (preserved) -->
                <Border Style="{StaticResource SectionCard}" 
                        StrokeThickness="1"
                        Padding="0"
                        x:Name="ChangelogBorder">
                    <WebView x:Name="ChangelogWebView"
                             HeightRequest="240"
                             BackgroundColor="Transparent"
                             VerticalOptions="FillAndExpand"/>
                </Border>

                <!-- App Information -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="About this app" Style="{StaticResource SectionLabel}"/>
                        <Label Text="TikTok AutoStreak is designed to automate and protect your TikTok streaks. It runs natively in the background on a schedule you configure, messaging your streak partners so you never miss a day." 
                               FontFamily="InterRegular"
                               FontSize="13"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Verified Release -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Verified Release" Style="{StaticResource SectionLabel}"/>
                        <Label Text="Custom Engineered for Mrblack"
                               FontFamily="InterBold" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="Obsidian Edition • Standalone Background Automation"
                               TextColor="{StaticResource TealCyan}"
                               FontFamily="InterMedium"
                               FontSize="11" />
                    </VerticalStackLayout>
                </Border>

                <!-- Data & Permissions Notice -->
                <VerticalStackLayout Spacing="6" Margin="0, 0, 0, 8">
                    <Label Text="Privacy &amp; System Permissions" 
                           FontFamily="InterSemiBold"
                           TextColor="{StaticResource TextSecondary}" 
                           FontSize="12"/>
                    <Label Text="All operations execute locally on your device. Zero credentials or messaging session keys are extracted or broadcasted remotely. Background automations require battery exemptions and exact-alarm scheduling to function reliably." 
                           FontFamily="InterRegular"
                           TextColor="{StaticResource BrandSubtitle}"
                           LineBreakMode="WordWrap" 
                           FontSize="11"/>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky Footer -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">

            <Label x:Name="ProgressLabel"
                   IsVisible="False"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource TextSecondary}"
                   FontSize="13"/>

            <Grid x:Name="UpdateButtonGrid"
                  ColumnDefinitions="*, 12, *"
                  IsVisible="False">
                <Button x:Name="LaterButton"
                        Grid.Column="0"
                        Text="Later"
                        BackgroundColor="{StaticResource ObsidianSurfaceElevated}"
                        TextColor="{StaticResource TextSecondary}"
                        CornerRadius="14"
                        HeightRequest="48"
                        Clicked="OnLaterClicked"/>
                <Button x:Name="InstallButton"
                        Grid.Column="2"
                        Text="Install"
                        BackgroundColor="{StaticResource CoralRed}"
                        TextColor="{StaticResource White}"
                        FontFamily="InterSemiBold"
                        CornerRadius="14"
                        HeightRequest="48"
                        Clicked="OnInstallClicked"/>
            </Grid>

            <Button x:Name="CloseButton"
                    Text="Continue"
                    BackgroundColor="{StaticResource CoralRed}"
                    TextColor="{StaticResource White}"
                    FontFamily="InterBold"
                    FontSize="15"
                    CornerRadius="16"
                    HeightRequest="50"
                    Clicked="OnCloseClicked"/>

        </VerticalStackLayout>
    </Grid>
</ContentPage>
